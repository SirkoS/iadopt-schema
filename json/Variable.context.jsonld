{
  "@context": {
    "@version": 1.1,

    "label": {
      "@id": "http://www.w3.org/2000/01/rdf-schema#label",
      "@container": ["@language", "@set"]
    },
    "comment": {
      "@id": "http://www.w3.org/2000/01/rdf-schema#comment",
      "@container": ["@language", "@set"]
    },

    "property": {
      "@id": "https://w3id.org/iadopt/ont/hasProperty",
      "@type": "@id"
    },

    "ooi": {
      "@id": "https://w3id.org/iadopt/ont/hasObjectOfInterest",
      "@type": "@id"
    },
    "objectofinterest": {
      "@id": "https://w3id.org/iadopt/ont/hasObjectOfInterest",
      "@type": "@id"
    },

    "matrix": {
      "@id": "https://w3id.org/iadopt/ont/hasMatrix",
      "@type": "@id"
    },

    "context": {
      "@id": "https://w3id.org/iadopt/ont/hasContextObject",
      "@type": "@id"
    },
    "contextobject": {
      "@id": "https://w3id.org/iadopt/ont/hasContextObject",
      "@type": "@id"
    },

    "statisticalmodifier": {
      "@id": "https://w3id.org/iadopt/ont/hasStatisticalModifier",
      "@type": "@id"
    },
    "statmod": {
      "@id": "https://w3id.org/iadopt/ont/hasStatisticalModifier",
      "@type": "@id"
    },

    "constraint": {
      "@id":    "https://w3id.org/iadopt/ont/hasConstraint",

      "@context": {
        "constrains": {
          "@id": "https://w3id.org/iadopt/ont/constrains",
          "@type": "@id"
        }
      }
    },



    "hasSource": {
      "@id":    "https://w3id.org/iadopt/ont/hasSource",
      "@type": "@id"
    },
    "hasTarget": {
      "@id":    "https://w3id.org/iadopt/ont/hasTarget",
      "@type": "@id"
    },

    "hasNumerator": {
      "@id":    "https://w3id.org/iadopt/ont/hasNumerator",
      "@type": "@id"
    },
    "hasDenominator": {
      "@id":    "https://w3id.org/iadopt/ont/hasDenominator",
      "@type": "@id"
    },

    "hasPart": {
      "@id":    "https://w3id.org/iadopt/ont/hasPart",
      "@type": "@id"
    }

  }
}