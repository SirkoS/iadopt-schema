{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$defs": {

    "simpleEntity": {
      "type":  "object",
      "properties": {
        "@id": { "type": "string" }
      },
      "required": [ "@id" ],
      "not": {
        "anyOf": [
          { "required": [ "hasDenominator" ] },
          { "required": [ "hasNumerator" ] },
          { "required": [ "hasSource" ] },
          { "required": [ "hasTarget" ] },
          { "required": [ "hasPart" ] }
        ]
      }
    },

    "entity": {
      "oneOf": [

        {
          "description": "simple entity - no iadopt:System",
          "$ref": "#/$defs/simpleEntity"
        },

        {
          "description": "iadopt:AsymmetricSystem using hasSource/hasTarget",
          "type":  "object",
          "properties": {
            "@id": { "type": "string" },
            "hasSource": { "$ref": "#/$defs/simpleEntity" },
            "hasTarget": { "$ref": "#/$defs/simpleEntity" }
          },
          "required": [ "hasSource", "hasTarget" ],
          "not": {
            "anyOf": [
              { "required": [ "hasDenominator" ] },
              { "required": [ "hasNumerator" ] },
              { "required": [ "hasPart" ] }
            ]
          }
        },

        {
          "description": "iadopt:AsymmetricSystem using hasDenominator/hasNumerator",
          "type":  "object",
          "properties": {
            "@id": { "type": "string" },
            "hasDenominator": { "$ref": "#/$defs/simpleEntity" },
            "hasNumerator":   { "$ref": "#/$defs/simpleEntity" }
          },
          "required": [ "hasDenominator", "hasNumerator" ],
          "not": {
            "anyOf": [
              { "required": [ "hasSource" ] },
              { "required": [ "hasTarget" ] },
              { "required": [ "hasPart" ] }
            ]
          }
        },

        {
          "description": "iadopt:SymmetricSystem",
          "type":  "object",
          "properties": {
            "@id": { "type": "string" },
            "hasPart": {
              "type":  "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/simpleEntity" },
              "unevaluatedItems": false
            }
          },
          "required": [ "hasPart" ],
          "not": {
            "anyOf": [
              { "required": [ "hasDenominator" ] },
              { "required": [ "hasNumerator" ] },
              { "required": [ "hasSource" ] },
              { "required": [ "hasTarget" ] }
            ]
          }
        }
      ]
    },

    "constraint": {
      "type": "object",
      "properties": {
        "constrains": {
          "@type": "string"
        },
        "@type": {
          "description": "Type definition has to include iadopt:Constraint.",
          "type": [ "string", "array" ],
          "items": {
            "type": "string"
          },
          "contains": {
            "const": "https://w3id.org/iadopt/ont/Constraint"
          },
          "pattern": "https://w3id.org/iadopt/ont/Constraint"
        }
      },
      "required": [ "constrains" ]
    }
  },

  "type": "object",
  "properties": {

    "@context": {
      "description": "Context for an I-Adopt Variable is fixed.",
      "const": "https://w3id.org/iadopt/Variable.context.jsonld"
    },
    "@id":   { "type": "string" },
    "@type": {
      "description": "Type definition has to include iadopt:Variable.",
      "type": [ "string", "array" ],
      "items": {
        "type": "string"
      },
      "contains": {
        "const": "https://w3id.org/iadopt/ont/Variable"
      },
      "pattern": "https://w3id.org/iadopt/ont/Variable"
    },

    "property":         { "$ref": "#/$defs/simpleEntity" },
    "ooi":              { "$ref": "#/$defs/entity" },
    "objectofinterest": { "$ref": "#/$defs/entity" },
    "matrix":           { "$ref": "#/$defs/entity" },
    "context": {
      "description": "contextObject can either be a single entity or an array of entities",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        { "$ref": "#/$defs/entity" }
      ]
    },

    "statisticalmodifier": { "$ref": "#/$defs/simpleEntity" },
    "statmod":             { "$ref": "#/$defs/simpleEntity" },

    "contextobject": {
      "description": "contextObject can either be a single entity or an array of entities",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        { "$ref": "#/$defs/entity" }
      ]
    },
    "constraint": {
      "description": "constraint can either be a single Constraint or an array of Constraints",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint"
          }
        },
        { "$ref": "#/$defs/constraint" }
      ]
    }


  },

  "allOf": [{
      "required": [ "@context", "@id", "@type", "property" ]
    }, {
      "not": {
        "required": ["context", "contextobject"]
      }
    }, {
      "not": {
        "required": ["context", "contextobject"]
      }
    }, {
      "oneOf": [
        { "required": ["ooi"] },
        { "required": ["objectofinterest"] }
      ]
    }, {
      "not": {
        "required": ["statmod", "statisticalmodifier"]
      }
    },

    { "not": { "required": [ "contextObject" ] },       "description": "all lower-case key required for context object" },
    { "not": { "required": [ "statMod" ] },             "description": "all lower-case key required for statmod" },
    { "not": { "required": [ "statisticalModifier" ] }, "description": "all lower-case key required for statistical modifier" }

  ]

}