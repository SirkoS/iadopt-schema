  "@id": "http://example.org/iadopt/Variable",
  "label": "Testing Variable",

  "property": {
    "@type": [
      "https://w3id.org/iadopt/ont/Property"
    ],
    "@id": "http://example.org/iadopt/Prop",
    "label": "property"
  },

  "ooi": {
    "@type": [
      "https://w3id.org/iadopt/ont/Entity",
