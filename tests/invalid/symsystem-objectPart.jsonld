    "label": "object of interest - SymmetricSystem",

    "hasPart": {
      "@type": [
        "https://w3id.org/iadopt/ont/Entity"
      ],
      "@id": "http://example.org/iadopt/SysPart1",
      "label": "system part 1"
    }

  }

}