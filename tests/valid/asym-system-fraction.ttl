@prefix ex: <http://example.org/iadopt/> .
@prefix iadopt: <https://w3id.org/iadopt/ont/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .


ex:Variable
  a           iadopt:Variable ;
  rdfs:label  "Testing Variable" ;
  iadopt:hasObjectOfInterest    ex:OoI ;
  iadopt:hasProperty            ex:Prop ;
  .


ex:Prop
  a          iadopt:Property ;
  rdfs:label "property" ;
  .

ex:OoI
  a                       iadopt:AsymmetricSystem ;
  iadopt:hasNumerator     ex:SysNumerator ;
  iadopt:hasDenominator   ex:SysDenominator ;
  rdfs:label "object of interest - AsymmetricSystem" ;
  .

ex:SysNumerator
  a          iadopt:Entity ;
  rdfs:label "system numerator" ;
  .

ex:SysDenominator
  a          iadopt:Entity ;
  rdfs:label "system denominator" ;
  .
