{
  "@context": "https://w3id.org/iadopt/Variable.context.jsonld",
  "@id": "http://example.org/iadopt/Variable",
  "@type": "https://w3id.org/iadopt/ont/Variable",
  "label": "Testing Variable",

  "property": {
    "@type": [ "https://w3id.org/iadopt/ont/Property" ],
    "@id": "http://example.org/iadopt/Prop",
    "label": "property"
  },

  "ooi": {
    "@type": [ "https://w3id.org/iadopt/ont/Entity" ],
    "@id": "http://example.org/iadopt/OoI",
    "label": "object of interest"
  },

  "matrix": {
    "@type": [ "https://w3id.org/iadopt/ont/Entity" ],
    "@id": "http://example.org/iadopt/Matrix",
    "label": "matrix"
  },

  "context": [{
    "@type": [ "https://w3id.org/iadopt/ont/Entity" ],
    "@id": "http://example.org/iadopt/Context",
    "label": "context"
  }],

  "statisticalmodifier": {
    "@type": [
      "https://w3id.org/iadopt/ont/StatisticalModifier"
    ],
    "@id": "http://example.org/iadopt/StatMod",
    "label": "statistical modifier"
  },

  "constraint": [
    {
      "@type": [
        "https://w3id.org/iadopt/ont/Constraint"
      ],
      "label": "constraint OoI",
      "constrains": [
        "http://example.org/iadopt/OoI"
      ]
    },
    {
      "@type": [
        "https://w3id.org/iadopt/ont/Constraint"
      ],
      "label": "constraint Prop",
      "constrains": [
        "http://example.org/iadopt/Prop"
      ]
    },
    {
      "@type": [
        "https://w3id.org/iadopt/ont/Constraint"
      ],
      "label": "constraint Matrix",
      "constrains": [
        "http://example.org/iadopt/Matrix"
      ]
    },
    {
      "@type": [
        "https://w3id.org/iadopt/ont/Constraint"
      ],
      "label": "constraint Context",
      "constrains": [
        "http://example.org/iadopt/Context"
      ]
    },
    {
      "@type": [
        "https://w3id.org/iadopt/ont/Constraint"
      ],
      "label": "constraint StatMod",
      "constrains": [
        "http://example.org/iadopt/StatMod"
      ]
    }
  ]

}
