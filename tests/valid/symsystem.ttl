@prefix ex: <http://example.org/iadopt/> .
@prefix iadopt: <https://w3id.org/iadopt/ont/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .


ex:Variable
  a           iadopt:Variable ;
  rdfs:label  "Testing Variable" ;
  iadopt:hasObjectOfInterest    ex:OoI ;
  iadopt:hasProperty            ex:Prop ;
  .


ex:Prop
  a          iadopt:Property ;
  rdfs:label "property" ;
  .

ex:OoI
  a               iadopt:SymmetricSystem ;
  iadopt:hasPart  ex:SysPart1, ex:SysPart2 ;
  rdfs:label "object of interest - SymmetricSystem" ;
  .

ex:SysPart1
  a          iadopt:Entity ;
  rdfs:label "system part 1" ;
  .

ex:SysPart2
  a          iadopt:Entity ;
  rdfs:label "system part 2" ;
  .
